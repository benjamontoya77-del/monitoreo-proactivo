# Copia este archivo a .env y ajusta los valores.
DB_PASSWORD=cambia_esta_clave_db
JWT_SECRET=genera-una-cadena-larga-con: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tuempresa.cl
ADMIN_PASSWORD=CambiaEstaClave.2026

# --- Motor de escaneo ---
PING_TIMEOUT_S=2
PING_INTENTOS=2
SNMP_TIMEOUT_S=2
HTTP_TIMEOUT_S=5
RETENCION_DIAS=30
SLA_OBJETIVO_PCT=99.0

# --- Telegram (canal principal). Crea el bot con @BotFather y obtén tu chat_id ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP (respaldo si Telegram falla o no está configurado) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
